#!/usr/bin/env bash
set -euo pipefail

CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/codex-window-keeper/config"
STATE_ROOT="${XDG_STATE_HOME:-$HOME/.local/state}/codex-window-keeper"
LOG_FILE="$STATE_ROOT/keeper.log"

# gtimeout covers macOS with coreutils installed via Homebrew (no bare
# `timeout` there); empty means neither is on PATH.
resolve_timeout_bin() {
  if command -v timeout >/dev/null 2>&1; then
    printf 'timeout'
  elif command -v gtimeout >/dev/null 2>&1; then
    printf 'gtimeout'
  fi
}
TIMEOUT_BIN="$(resolve_timeout_bin)"

# Formats an epoch seconds value as local time on both GNU and BSD date.
fmt_epoch() {
  if date -d "@$1" '+%Y-%m-%d %H:%M:%S' 2>/dev/null; then
    return 0
  fi
  date -r "$1" '+%Y-%m-%d %H:%M:%S'
}

log() {
  mkdir -p "$STATE_ROOT"
  printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$1" >> "$LOG_FILE"
}

load_config() {
  if [[ ! -f "$CONFIG_FILE" ]]; then
    echo "config not found: $CONFIG_FILE (run install.sh first)" >&2
    exit 1
  fi
  # shellcheck disable=SC1090
  source "$CONFIG_FILE"
  : "${CODEX_BIN:?CODEX_BIN not set in $CONFIG_FILE}"
  : "${MODEL:?MODEL not set in $CONFIG_FILE}"
  : "${ACCOUNTS:?ACCOUNTS not set in $CONFIG_FILE}"
  : "${WINDOW_SECS:?WINDOW_SECS not set in $CONFIG_FILE}"
  : "${PING_TIMEOUT:?PING_TIMEOUT not set in $CONFIG_FILE}"
  : "${RPC_TIMEOUT:?RPC_TIMEOUT not set in $CONFIG_FILE}"
  : "${PROMPT:?PROMPT not set in $CONFIG_FILE}"
  REASONING_EFFORT="${REASONING_EFFORT:-low}"
  BACKOFF_SECS="${BACKOFF_SECS:-1800}"
}

account_state_dir() {
  printf '%s/%s' "$STATE_ROOT" "$1"
}

# Resolve the same account directory for reads and requests, including manual commands.
account_codex_home() {
  local label="$1" var
  if [[ "$label" == "default" ]]; then
    printf '%s' "${CODEX_HOME_default:-${CODEX_HOME:-$HOME/.codex}}"
    return 0
  fi
  var="CODEX_HOME_$label"
  if [[ -z "${!var:-}" ]]; then
    echo "missing CODEX_HOME_$label for account '$label' in $CONFIG_FILE" >&2
    exit 1
  fi
  printf '%s' "${!var}"
}

numeric_or_null() {
  if [[ -z "$1" || "$1" == "null" ]]; then
    printf 'null'
  else
    printf '%s' "$1"
  fi
}

# Free RPC read of account/rateLimits/read. Prints .result.rateLimits and
# returns 0 on success, prints nothing and returns 1 on any failure.
#
# stdin to `codex app-server` must stay open until the async reply lands, or
# the process exits at EOF before the id:2 response is ever written. A FIFO
# held open on our side (fd 9) is what keeps it alive.
read_limits() {
  local label="$1" codex_home fifo out_file pid line elapsed err rate_limits
  codex_home="$(account_codex_home "$label")"

  fifo="$(mktemp -u "${TMPDIR:-/tmp}/cwk-fifo.XXXXXX")"
  out_file="$(mktemp "${TMPDIR:-/tmp}/cwk-out.XXXXXX")"
  mkfifo "$fifo"

  local env_args=()
  if [[ -n "$codex_home" ]]; then
    env_args=("CODEX_HOME=$codex_home")
  fi

  "$TIMEOUT_BIN" "$((RPC_TIMEOUT + 10))" env "${env_args[@]+"${env_args[@]}"}" "$CODEX_BIN" app-server \
    < "$fifo" > "$out_file" 2>/dev/null &
  pid=$!

  exec 9>"$fifo"
  printf '%s\n' \
    '{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"clientInfo":{"name":"cwk","title":"cwk","version":"1.0.0"}}}' \
    '{"jsonrpc":"2.0","method":"initialized","params":{}}' \
    '{"jsonrpc":"2.0","id":2,"method":"account/rateLimits/read","params":{"excludeResetCreditDetails":true}}' \
    >&9

  line=""
  elapsed=0
  while [[ "$elapsed" -lt "$RPC_TIMEOUT" ]]; do
    line="$(grep -m1 '"id":2' "$out_file" 2>/dev/null || true)"
    if [[ -n "$line" ]]; then
      break
    fi
    if ! kill -0 "$pid" 2>/dev/null; then
      break
    fi
    sleep 1
    elapsed=$((elapsed + 1))
  done

  exec 9>&-
  kill "$pid" 2>/dev/null || true
  wait "$pid" 2>/dev/null || true
  rm -f "$fifo" "$out_file"

  if [[ -z "$line" ]]; then
    return 1
  fi

  err="$(printf '%s' "$line" | jq -r '.error // empty' 2>/dev/null || true)"
  if [[ -n "$err" ]]; then
    return 1
  fi

  rate_limits="$(printf '%s' "$line" | jq -c '.result.rateLimits // empty' 2>/dev/null || true)"
  if [[ -z "$rate_limits" || "$rate_limits" == "null" ]]; then
    return 1
  fi

  printf '%s\n' "$rate_limits"
}

# Local opaque identity: stable through token refresh when account_id is available.
# File contents are hashed only as a fallback, never logged or stored in state.
account_key() {
  local codex_home identity
  codex_home="$(account_codex_home "$1")"
  if [[ -d "$codex_home" ]]; then codex_home="$(cd "$codex_home" && pwd -P)"; fi
  identity="$(jq -r '.tokens.account_id // .account_id // empty' "$codex_home/auth.json" 2>/dev/null || true)"
  if [[ -z "$identity" ]]; then
    # No file identity means we cannot safely reuse history (e.g. keychain-only auth).
    [[ -f "$codex_home/auth.json" ]] || return 0
    identity="$(cksum < "$codex_home/auth.json")"
  fi
  printf '%s\n%s' "$codex_home" "$identity" | cksum | awk '{print $1 ":" $2}'
}

load_account_state() {
  local path key="$2" now="$3" saved
  path="$(account_state_dir "$1")/state.json"
  saved="$(cat "$path" 2>/dev/null || true)"
  printf '%s' "${saved:-null}" | jq -c --arg key "$key" --argjson now "$now" \
    --argjson duration "$WINDOW_SECS" --argjson retry "$((BACKOFF_SECS + PING_TIMEOUT))" '
    def timestamp: type == "number" and . >= 0 and . == floor;
    if type == "object" and .version == 2 and $key != "" and .account_key == $key
      and ([.last_checked_at, .last_ping_at, .last_ping_attempt_at, .retry_after, .unconfirmed_until]
           | all(.[]; timestamp))
    then
      if .last_checked_at > $now then
        .retry_after = (if .retry_after > .last_checked_at then $now+$retry else 0 end) |
        .unconfirmed_until = (if .unconfirmed_until > .last_checked_at
          or (.last_ping_at > 0 and (.confirmed_reset_at // 0) > .last_checked_at)
          then $now+$duration else 0 end) |
        .observation=null | .confirmed_reset_at=null | .last_checked_at=$now
      else . end
    else empty end' 2>/dev/null || true
}

empty_state() {
  jq -cn --arg key "$1" '{version:2, account_key:$key, last_checked_at:0,
    last_ping_at:0,last_ping_attempt_at:0,retry_after:0,unconfirmed_until:0,
    confirmed_reset_at:null,observation:null,last_result:"never",last_error:""}'
}

save_state() {
  local state_dir tmp
  state_dir="$(account_state_dir "$1")"
  mkdir -p "$state_dir"
  tmp="$(mktemp "$state_dir/state.json.tmp.XXXXXX")"
  printf '%s\n' "$2" > "$tmp"
  mv "$tmp" "$state_dir/state.json"
}

# A pure decision shared by tick, dry-run and status. Comparisons deliberately
# span normal ticks (5-20 minutes), not two reads of the same short-lived cache.
classify_limits() {
  jq -cn --argjson limits "$1" --argjson state "$2" --argjson now "$3" \
    --argjson force "$4" '
    def percent: type == "number" and . >= 0 and . <= 100;
    def epoch: type == "number" and . > 0 and . == floor;
    def abs: if . < 0 then -. else . end;
    def verdict($a;$s;$r): {action:$a,window_status:$s,reason:$r,confirmed_reset_at:null};
    [$limits.primary?, $limits.secondary? | select(type == "object" and .windowDurationMins == 300)] as $windows |
    [$limits.primary?, $limits.secondary? | select(type == "object" and .windowDurationMins == 10080)] as $weeks |
    $windows[0] as $w | $weeks[0] as $week |
    {source:"live",observation:null,resets_at:($w.resetsAt // null),
     used_pct:($w.usedPercent // null),weekly_used_pct:($week.usedPercent // null),
     plan_type:($limits.planType // null)} as $base |
    if ($windows|length) != 1 or ($w.usedPercent|percent|not) or ($w.resetsAt|epoch|not)
      or (($weeks|length) > 0 and (($week.usedPercent|percent|not) or ($week.resetsAt|epoch|not)))
    then $base + verdict("backoff";"UNKNOWN";"missing or invalid five-hour/weekly window data")
    else
      {at:$now,reset:$w.resetsAt,used:$w.usedPercent,duration:300,
       limit_id:($limits.limitId // "codex"),plan:($limits.planType // null)} as $obs |
      $state.observation as $old |
      ($obs | {duration,limit_id,plan}) as $scope |
      ($state.window_scope // null) as $prior_scope |
      ($prior_scope != null and $prior_scope != $scope) as $scope_changed |
      (try ($old != null and $old.duration == 300 and $old.limit_id == $obs.limit_id
       and $old.plan == $obs.plan) catch false) as $same_window |
      (try ($same_window and ($old.at|epoch) and ($old.reset|epoch) and ($old.used|percent)
       and ($now-$old.at) >= 300 and ($now-$old.at) <= 1200 and $old.reset > $now) catch false) as $comparable |
      (if $comparable then (($w.resetsAt-$old.reset|abs) <= 60
        and $w.resetsAt-$now < 17940) else false end) as $fixed |
      (try ($same_window and $state.confirmed_reset_at > $now
        and ($w.resetsAt-$state.confirmed_reset_at|abs) <= 60) catch false) as $confirmed |
      (try ($same_window and $state.last_ping_at > 0
        and $state.confirmed_reset_at >= $state.last_ping_at
        and $state.confirmed_reset_at <= $now) catch false) as $known_expired |
      (if $comparable then ($old.used == 0 and $w.usedPercent == 0
        and ($old.reset-$old.at-18000|abs) <= 60
        and ($w.resetsAt-$now-18000|abs) <= 60
        and ($w.resetsAt-$old.reset-($now-$old.at)|abs) <= 60) else false end) as $sliding |
      $base + {observation:$obs,window_scope:$scope,scope_changed:$scope_changed} + (
        if ($week != null and $week.usedPercent >= 100 and $week.resetsAt > $now)
          or ($w.usedPercent >= 100 and $w.resetsAt > $now)
          or $limits.spendControlReached == true
        then verdict("skip";"EXHAUSTED";"quota exhausted; waiting for reset")
        elif $force == 1 then verdict("ping";"LAPSED";"explicit request") +
          {confirmed_reset_at:(if $w.resetsAt > $now and ($w.usedPercent > 0 or $fixed or $confirmed)
            then $w.resetsAt else null end)}
        elif $w.resetsAt > $now and ($w.usedPercent > 0 or $fixed or $confirmed)
        then verdict("skip";"ACTIVE";"window active") + {confirmed_reset_at:$w.resetsAt}
        elif $state.unconfirmed_until > $now and ($known_expired|not) and ($scope_changed|not)
        then verdict("observe";"UNCONFIRMED";"request completed; awaiting window confirmation, repeat suppressed")
        elif $w.resetsAt <= $now then verdict("ping";"LAPSED";"window expired")
        elif $sliding then verdict("ping";"LAPSED";"zero-use reset slides with observation time")
        else verdict("observe";"OBSERVING";"need another comparable snapshot") end)
    end'
}

# Globals are scoped dynamically to the caller. Read-only callers do not persist
# these observations or change retry timers.
inspect_account() {
  local label="$1" force="$2" respect_retry="${3:-1}" limits
  CHECKED_AT="$(date +%s)"
  ACCOUNT_KEY="$(account_key "$label")"
  ACCOUNT_STATE="$(load_account_state "$label" "$ACCOUNT_KEY" "$CHECKED_AT")"
  [[ -n "$ACCOUNT_STATE" ]] || ACCOUNT_STATE="$(empty_state "$ACCOUNT_KEY")"
  if [[ "$force" -eq 0 && "$respect_retry" -eq 1 ]] && \
    (( $(printf '%s' "$ACCOUNT_STATE" | jq -r '.retry_after') > CHECKED_AT )); then
    DECISION='{"action":"backoff","window_status":"BACKOFF","reason":"retry deadline not reached","source":"stale","observation":null}'
    return 0
  fi
  if limits="$(read_limits "$label")" && printf '%s' "$limits" | jq -e 'type == "object"' >/dev/null 2>&1; then
    DECISION="$(classify_limits "$limits" "$ACCOUNT_STATE" "$CHECKED_AT" "$force")"
    if [[ -z "$ACCOUNT_KEY" ]]; then
      DECISION="$(printf '%s' "$DECISION" | jq -c '. + {action:"backoff",window_status:"UNKNOWN",reason:"account file identity unavailable",observation:null}')"
    fi
  else
    DECISION='{"action":"backoff","window_status":"UNKNOWN","reason":"rate limit read failed","source":"stale","observation":null}'
  fi
}

record_decision() {
  jq -cn --argjson state "$1" --argjson decision "$2" --argjson now "$3" \
    --argjson backoff "$BACKOFF_SECS" '
    $state + {last_checked_at:$now,last_result:$decision.action,
      last_error:(if $decision.action == "backoff" then $decision.reason else "" end),
      window_status:$decision.window_status,reason:$decision.reason,source:$decision.source,
      observation:($decision.observation // $state.observation),
      window_scope:($decision.window_scope // $state.window_scope),
      confirmed_reset_at:(if $decision.observation == null
        then $state.confirmed_reset_at else ($decision.confirmed_reset_at // null) end),
      unconfirmed_until:(if $decision.scope_changed == true or ($decision.confirmed_reset_at // 0) > $now
        or ($state.last_ping_at > 0 and ($state.confirmed_reset_at // 0) >= $state.last_ping_at
          and $state.confirmed_reset_at <= $now)
        then 0 else $state.unconfirmed_until end),
      retry_after:(if $decision.action == "backoff" then $now+$backoff else 0 end)}'
}

resets_in_minutes() {
  local resets_at="$1" now diff
  now="$(date +%s)"
  diff=$(( resets_at - now ))
  (( diff < 0 )) && diff=0
  echo $(( diff / 60 ))
}

resets_in_human() {
  local resets_at="$1" now diff abs_diff hours mins
  now="$(date +%s)"
  diff=$(( resets_at - now ))
  if (( diff >= 0 )); then
    abs_diff=$diff
  else
    abs_diff=$(( -diff ))
  fi
  hours=$(( abs_diff / 3600 ))
  mins=$(( (abs_diff % 3600) / 60 ))
  if (( diff >= 0 )); then
    printf 'in %dh%dm' "$hours" "$mins"
  else
    printf '%dh%dm ago' "$hours" "$mins"
  fi
}

# Decides ping/skip/backoff for one account without pinging or writing state.
decide_dry_run() {
  local ACCOUNT_KEY ACCOUNT_STATE CHECKED_AT DECISION
  inspect_account "$1" "$2"
  printf '%s' "$DECISION" | jq -r --arg label "$1" '"would-\(.action) \($label) \(.reason)"'
}

# Atomic mkdir-based lock, portable to macOS bash 3.2. Stores the holder's
# pid in lock.d/pid so a stale lock from a dead process can be reclaimed.
acquire_lock() {
  local label="$1" state_dir lock_dir pid
  state_dir="$(account_state_dir "$label")"
  lock_dir="$state_dir/lock.d"
  mkdir -p "$state_dir"

  if mkdir "$lock_dir" 2>/dev/null; then
    printf '%s' "$$" > "$lock_dir/pid"
    return 0
  fi

  pid="$(cat "$lock_dir/pid" 2>/dev/null || true)"
  if [[ -n "$pid" ]] && ! kill -0 "$pid" 2>/dev/null; then
    rm -rf "$lock_dir"
    if mkdir "$lock_dir" 2>/dev/null; then
      printf '%s' "$$" > "$lock_dir/pid"
      return 0
    fi
  fi

  return 1
}

release_lock() {
  local label="$1"
  rm -rf "$(account_state_dir "$label")/lock.d"
}

ping_account() {
  local label="$1" force="$2" ACCOUNT_KEY ACCOUNT_STATE CHECKED_AT DECISION
  local action reason state ping_out ping_rc codex_home after limits2 post decision_key
  if ! acquire_lock "$label"; then
    log "skip $label locked (another run in progress)"
    return 0
  fi
  # shellcheck disable=SC2064
  trap "release_lock '$label'" EXIT
  inspect_account "$label" "$force"
  action="$(printf '%s' "$DECISION" | jq -r '.action')"
  reason="$(printf '%s' "$DECISION" | jq -r '.reason')"
  if [[ "$reason" == "retry deadline not reached" ]]; then
    # Persist a clock-rebased deadline once; otherwise every tick extends it.
    save_state "$label" "$ACCOUNT_STATE"
    log "backoff $label $reason"
    release_lock "$label"; trap - EXIT; return 0
  fi
  state="$(record_decision "$ACCOUNT_STATE" "$DECISION" "$CHECKED_AT")"
  save_state "$label" "$state"
  if [[ "$action" != "ping" ]]; then
    log "$action $label $reason $(printf '%s' "$DECISION" | jq -c '{observed:.observation.at,reset:.observation.reset,used:.observation.used,status:.window_status}')"
    release_lock "$label"; trap - EXIT; return 0
  fi

  # Auth may have changed during the read. Never spend against a different
  # identity than the one whose state authorized the request.
  decision_key="$(account_key "$label")"
  if [[ "$decision_key" != "$ACCOUNT_KEY" ]]; then
    log "observe $label account changed during read"
    release_lock "$label"; trap - EXIT; return 0
  fi
  codex_home="$(account_codex_home "$label")"
  state="$(printf '%s' "$state" | jq -c --argjson now "$CHECKED_AT" --argjson guard "$((PING_TIMEOUT + BACKOFF_SECS))" \
    '. + {last_ping_attempt_at:$now,last_result:"ping-started",retry_after:($now+$guard)}')"
  save_state "$label" "$state"
  log "ping $label start reason=$reason"
  if ping_out="$("$TIMEOUT_BIN" "$PING_TIMEOUT" env "CODEX_HOME=$codex_home" "$CODEX_BIN" exec \
    --ephemeral --ignore-user-config --ignore-rules --skip-git-repo-check \
    -s read-only -m "$MODEL" -c "model_reasoning_effort=$REASONING_EFFORT" --json \
    "$PROMPT" < /dev/null 2>/dev/null)"; then ping_rc=0; else ping_rc=$?; fi
  after="$(date +%s)"
  if [[ "$ping_rc" -ne 0 ]] || ! printf '%s' "$ping_out" | jq -es 'any(.[]; .type? == "turn.completed")' >/dev/null 2>&1; then
    state="$(printf '%s' "$state" | jq -c --argjson now "$after" --argjson retry "$BACKOFF_SECS" --arg err "ping failed (rc=$ping_rc)" \
      '. + {last_result:"error",last_error:$err,window_status:"UNKNOWN",retry_after:($now+$retry)}')"
    save_state "$label" "$state"
    log "ping $label failed rc=$ping_rc retry_after=$((after + BACKOFF_SECS))"
    release_lock "$label"; trap - EXIT; return 0
  fi

  # Save completion BEFORE the post-read, so an interrupted read cannot trigger
  # another successful request on the next tick.
  state="$(printf '%s' "$state" | jq -c --argjson now "$after" --argjson duration "$WINDOW_SECS" \
    '. + {last_ping_at:$now,last_result:"ping-unconfirmed",last_error:"",window_status:"UNCONFIRMED",
          retry_after:0,unconfirmed_until:($now+$duration)}')"
  save_state "$label" "$state"
  if limits2="$(read_limits "$label")" && printf '%s' "$limits2" | jq -e 'type == "object"' >/dev/null 2>&1; then
    post="$(date +%s)"
    DECISION="$(classify_limits "$limits2" "$state" "$post" 0)"
    state="$(record_decision "$state" "$DECISION" "$post")"
  fi
  state="$(printf '%s' "$state" | jq -c --argjson now "$after" '
    .retry_after=0 | if (.confirmed_reset_at // 0) > $now
    then .last_result="ok" | .window_status="ACTIVE" | .unconfirmed_until=0
    else .last_result="ping-unconfirmed" | .window_status="UNCONFIRMED" end')"
  save_state "$label" "$state"
  log "ping $label completed $(printf '%s' "$state" | jq -c '{status:.window_status,reset:.observation.reset,confirmed_reset:.confirmed_reset_at}')"
  release_lock "$label"; trap - EXIT
}

# Checks deps. mode "read" (status, dry-run) covers what read_limits needs;
# "full" (tick/ping) has no extra deps beyond that. mode "basic" (log) needs jq only.
require_deps() {
  local mode="$1"
  local missing=()

  command -v jq >/dev/null 2>&1 || missing+=("jq")

  if [[ "$mode" == "read" || "$mode" == "full" ]]; then
    command -v mkfifo >/dev/null 2>&1 || missing+=("mkfifo")
    [[ -n "$TIMEOUT_BIN" ]] || missing+=("timeout or gtimeout")
    if [[ -z "${CODEX_BIN:-}" ]] || [[ ! -x "$CODEX_BIN" ]]; then
      missing+=("CODEX_BIN (${CODEX_BIN:-unset})")
    fi
  fi

  if [[ ${#missing[@]} -gt 0 ]]; then
    local item
    for item in "${missing[@]}"; do
      log "error missing dependency: $item"
      echo "error missing dependency: $item" >&2
    done
    exit 1
  fi
}

account_list_array() {
  local labels="$1"
  IFS=' ' read -ra ACCOUNT_LIST <<< "$labels"
}

run_tick() {
  local force="$1" dry_run="$2" account="$3" labels label
  labels="${account:-$ACCOUNTS}"
  account_list_array "$labels"

  for label in "${ACCOUNT_LIST[@]+"${ACCOUNT_LIST[@]}"}"; do
    if [[ "$dry_run" -eq 1 ]]; then
      decide_dry_run "$label" "$force"
      continue
    fi
    ping_account "$label" "$force"
  done
}

run_status() {
  local account="$1" labels label ACCOUNT_KEY ACCOUNT_STATE CHECKED_AT DECISION
  labels="${account:-$ACCOUNTS}"
  account_list_array "$labels"
  for label in "${ACCOUNT_LIST[@]+"${ACCOUNT_LIST[@]}"}"; do
    inspect_account "$label" 0 0
    local state resets used weekly plan source last_ping result reason resets_local countdown ping_local
    state="$(printf '%s' "$DECISION" | jq -r '.window_status')"
    source="$(printf '%s' "$DECISION" | jq -r '.source')"
    resets="$(printf '%s' "$DECISION" | jq -r '.resets_at // empty')"
    used="$(printf '%s' "$DECISION" | jq -r '.used_pct // "-"')"
    weekly="$(printf '%s' "$DECISION" | jq -r '.weekly_used_pct // "-"')"
    plan="$(printf '%s' "$DECISION" | jq -r '.plan_type // "-"')"
    last_ping="$(printf '%s' "$ACCOUNT_STATE" | jq -r '.last_ping_at')"
    result="$(printf '%s' "$ACCOUNT_STATE" | jq -r '.last_result')"
    reason="$(printf '%s' "$DECISION" | jq -r '.reason')"
    resets_local="-"; countdown="-"; ping_local="-"
    if [[ "$resets" =~ ^[0-9]+$ ]]; then
      resets_local="$(fmt_epoch "$resets")"
      countdown="$(resets_in_human "$resets")"
    fi
    if (( last_ping > 0 )); then ping_local="$(fmt_epoch "$last_ping")"; fi
    printf '%-10s %-11s resets=%s (%s) used_pct=%s weekly_pct=%s plan=%s source=%s last_ping=%s last_result=%s reason=%s\n' \
      "$label" "$state" "$resets_local" "$countdown" "$used" "$weekly" "$plan" "$source" "$ping_local" "$result" "$reason"
  done
}

run_log() {
  if [[ -f "$LOG_FILE" ]]; then
    tail -n 50 "$LOG_FILE"
  else
    echo "no log yet: $LOG_FILE"
  fi
}

main() {
  local cmd="" force=0 dry_run=0 account=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --force) force=1; shift ;;
      --dry-run) dry_run=1; shift ;;
      --account) account="$2"; shift 2 ;;
      tick|ping|status|log) cmd="$1"; shift ;;
      *) echo "unknown argument: $1" >&2; exit 1 ;;
    esac
  done
  [[ -z "$cmd" ]] && cmd="tick"

  case "$cmd" in
    tick)
      load_config
      if [[ "$dry_run" -eq 1 ]]; then
        require_deps read
      else
        require_deps full
      fi
      run_tick "$force" "$dry_run" "$account"
      ;;
    ping)
      load_config
      require_deps full
      run_tick 1 "$dry_run" "$account"
      ;;
    status)
      load_config
      require_deps read
      run_status "$account"
      ;;
    log)
      require_deps basic
      run_log
      ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "$@"
fi
